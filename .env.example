# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# EVERY key the application reads is listed here. If you add a setting to
# src/sayari_poc/config.py, add it here in the same commit — the reference
# project shipped a .env.example documenting nothing while .env defined three
# keys, and that is the defect this file exists to prevent.
#
# A credential-less offline run needs NONE of these. `python -m sayari_poc run
# --offline` works from a clean clone with no .env at all; the committed cache
# supplies every response; the risk ontology is also committed.

# --- Sayari credentials (live runs only) ---------------------------------
# Obtained from Sayari. Never hardcode these, never log them, never commit them.
SAYARI_CLIENT_ID=
SAYARI_CLIENT_SECRET=

# --- Sayari endpoint -------------------------------------------------------
# Production by default. The SDK also knows DEV (api.internal.sayari.com) and
# PRODUCTION_UK (api.uk.sayari.com).
SAYARI_API_BASE=https://api.sayari.com

# Optional CA bundle path, for corporate TLS interception. Supplied to the
# injected httpx client as `verify=`. Leave blank to use the system trust store.
SAYARI_CA_BUNDLE=

# --- Input -----------------------------------------------------------------
# The supplied exercise workbook, opened read-only and never modified.
# TRACKED, at data/input/ — 14 KB, Sayari's own supplied input, returned to
# Sayari. Without it a clean clone cannot ingest anything and the offline
# reproducibility claim is false (decision recorded 2026-09-20, task P0b).
# data/private/ remains gitignored for any genuinely private material.
ENTITY_FILE_PATH=data/input/Sayari_Interview_Exercise_List.xlsx

# --- Request bounds --------------------------------------------------------
# Hard ceiling on data HTTP attempts per run, retries included. OAuth token
# requests are counted separately and are NOT charged against this budget.
CALL_BUDGET=400

# Upstream traversal bounds. The API documents max_depth as 1-4 inclusive,
# default 4, and documents no pagination for this endpoint. This project runs
# one below that default on Sayari's own guidance, "Reduce if query is timing
# out": 16 of 46 attempted retrievals already come back with the API's
# partial_results flag at depth 3.
MAX_UPSTREAM_DEPTH=3
UPSTREAM_LIMIT=500

# Hub suppression threshold: shared upstream entities present in more than this
# many countries are treated as global distributors and excluded from the
# convergence ranking. They remain in the evidence.
HUB_MAX_COUNTRIES=10

# --- SDK transport ---------------------------------------------------------
# Passed to the SDK as RequestOptions(max_retries=...). Measured on sayari 0.1.43:
# for 429/500/408, default or N=1/2 -> 1 attempt; N=3 -> 2; N=5 -> 4.
# Choose 5 for three retries (four total data attempts), each charged to the
# transport budget. Default retries do not fire.
SDK_MAX_RETRIES=5

# Per-request timeout in seconds, passed to the SDK client.
SDK_TIMEOUT_SECONDS=60

# --- Committed evidence ----------------------------------------------------
# The cache is tracked so a reviewer can reproduce the analysis offline.
#
# A live or --refresh run writes into data/cache/, so it will show up in
# `git status`. That is intended: refreshing the evidence should be visible.
CACHE_DIR=data/cache

# --- Regenerable artefacts -------------------------------------------------
# data/processed/ holds build output only, and is gitignored in its entirety:
# findings.json, report.html, the CSV, run_manifest.json and the DuckDB file.
DUCKDB_PATH=data/processed/analysis.duckdb

# Optional declared generation time: ISO-8601 with a timezone offset, emitted
# verbatim. Overrides the previous artifact's time; blank keeps wall-clock and
# unchanged-replay carry-forward behaviour. The manifest records declared/observed.
# For exact committed-report replay: 2026-09-24T01:52:59.468774+00:00
# SOURCE_DATE_EPOCH is not consumed: integer seconds cannot preserve microseconds.
DECLARED_GENERATED_AT=
